<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console harness to try the engine (Identifier, LocalDb, ...) without ComicRack.
       Build the plugin first (dotnet build -c Release in the repository root). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Platform>AnyCPU</Platform>
    <PluginDll>$(MSBuildThisFileDirectory)..\..\bin\Release\net48\ComicVineAI.dll</PluginDll>
    <ComicRackBin Condition="'$(ComicRackBin)' == ''">$(MSBuildThisFileDirectory)..\..\..\ComicRackCE\ComicRack\bin\Release\net48\</ComicRackBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ComicVineAI"><HintPath>$(PluginDll)</HintPath></Reference>
    <Reference Include="ComicRack.Engine"><HintPath>$(ComicRackBin)ComicRack.Engine.dll</HintPath></Reference>
    <Reference Include="cYo.Common"><HintPath>$(ComicRackBin)cYo.Common.dll</HintPath></Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
