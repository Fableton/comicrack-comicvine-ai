<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ComicVineAI</AssemblyName>
    <!-- the version of the plugin: shown in the windows and in the log (AppInfo) and in the name of the release zip -->
    <Version>0.2.0</Version>
    <!-- every normal build is stamped with the date and time (MMdd-HHmm) so the builds that are tried one after another can be told
         apart in the windows and in the log; package.ps1 builds with -p:ReleaseBuild=true, which leaves the stamp out -->
    <BuildStamp Condition="'$(ReleaseBuild)' != 'true'">$([System.DateTime]::Now.ToString('MMdd-HHmm'))</BuildStamp>
    <InformationalVersion Condition="'$(BuildStamp)' != ''">$(Version)+$(BuildStamp)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>ComicVineAI</RootNamespace>
    <Nullable>disable</Nullable>
    <Platform>AnyCPU</Platform>
    <!-- Build output of ComicRackCE built from the origin/feature/dotnet-plugin branch.
         Override with: dotnet build -p:ComicRackBin=... -->
    <ComicRackBin Condition="'$(ComicRackBin)' == ''">$(MSBuildThisFileDirectory)..\ComicRackCE\ComicRack\bin\Release\net48\</ComicRackBin>
  </PropertyGroup>

  <ItemGroup>
    <!-- the test harness has its own project -->
    <Compile Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ComicRack.Plugins">
      <HintPath>$(ComicRackBin)ComicRack.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ComicRack.Engine">
      <HintPath>$(ComicRackBin)ComicRack.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="cYo.Common">
      <HintPath>$(ComicRackBin)cYo.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- the button of the plugin in the toolbar of the book list; ComicRack finds it by the Image name of the plugin -->
    <EmbeddedResource Include="Resources\comicvineai.png" />
    <!-- texts of the plugin: Loc finds them as ComicVineAI.lang.<code>.json -->
    <EmbeddedResource Include="Languages\*.json" LogicalName="ComicVineAI.lang.%(Filename)%(Extension)" />
    <!-- SQLite (official build, public domain, with FTS5) for the optional local Comic Vine database. The plugin stays a single DLL:
         it writes the library for its architecture to %LOCALAPPDATA%\ComicVineAI\native on first use. -->
    <EmbeddedResource Include="Native\e_sqlite3.x64.dll" LogicalName="ComicVineAI.native.e_sqlite3.x64.dll" />
    <EmbeddedResource Include="Native\e_sqlite3.x86.dll" LogicalName="ComicVineAI.native.e_sqlite3.x86.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" />
    <!-- the log file (FileLog). Compile time only: the DLL is embedded below, not copied next to the plugin -->
    <PackageReference Include="log4net" Version="3.6.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- log4net goes inside ComicVineAI.dll (the plugin stays a single file); FileLog loads it from there -->
  <Target Name="EmbedLog4net" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferencePath)" Condition="'%(Filename)' == 'log4net'" LogicalName="ComicVineAI.lib.log4net.dll" />
    </ItemGroup>
  </Target>

</Project>
